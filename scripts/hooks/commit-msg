#!/usr/bin/env bash
# Commit-msg hook: 拒绝 AI 工具把自身写入提交署名（Co-Authored-By / Generated with 等）。
# 设计依据: AGENTS.md 核心规则 1（提交约定）。
#
# 安装（per worktree，已由 dev.sh start 自动完成）:
#   git config core.hooksPath scripts/hooks
#   chmod +x scripts/hooks/commit-msg
#
# 绕过（不推荐）: git commit --no-verify

set -e

MSG_FILE="$1"
[ -n "$MSG_FILE" ] && [ -f "$MSG_FILE" ] || exit 0

# AI 工具/厂商标识。只匹配署名行/生成尾注，普通正文提到这些词不受影响。
AI_PATTERN='(claude|anthropic|codex|openai|chatgpt|gpt-[0-9]|copilot|gemini|cursor|aider|devin|windsurf|cline|roo[ -]?code|opencode|sourcegraph|cody|codebuff|freebuff)'

# 1) 协作者/署名类 trailer：值里出现 AI 标识即拒绝。
HIT=$(grep -Ein "^[[:space:]]*(co-authored-by|co-author|assisted-by|generated-by|authored-by)[[:space:]]*:.*$AI_PATTERN" "$MSG_FILE" || true)
if [ -n "$HIT" ]; then
  echo "[commit-msg] 拒绝提交：提交信息包含 AI 工具署名" >&2
  echo "$HIT" | sed 's/^/  /' >&2
  echo "  作者只能是 git config 的 user.name / user.email。" >&2
  echo "  见 AGENTS.md「提交约定」；确需绕过用 git commit --no-verify。" >&2
  exit 1
fi

# 2) "Generated with <AI>" / "🤖 Generated with ..." 式尾注。
HIT_GEN=$(grep -Ein "generated[ -](with|by)[^\n]*$AI_PATTERN" "$MSG_FILE" || true)
if [ -n "$HIT_GEN" ]; then
  echo "[commit-msg] 拒绝提交：提交信息包含 AI 生成工具尾注" >&2
  echo "$HIT_GEN" | sed 's/^/  /' >&2
  echo "  见 AGENTS.md「提交约定」；确需绕过用 git commit --no-verify。" >&2
  exit 1
fi

exit 0
